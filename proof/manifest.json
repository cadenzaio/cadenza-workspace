        {
          "label": "contract snapshots",
          "cwd": ".",
          "command": "node",
          "args": ["scripts/check-contract-snapshots.mjs"]
        },
        {
          "label": "TypeScript core",
          "cwd": "cadenza",
          "command": "yarn",
          "args": ["test"]
        },
        {
          "label": "Environment contracts",
          "cwd": "cadenza-environment",
          "command": "npm",
          "args": ["run", "typecheck"]
        },
        {
          "label": "Chamber protocol",
          "cwd": "cadenza-chamber",
          "command": "cargo",
          "args": ["test", "--locked", "--test", "cell_protocol"]
        },
        {
          "label": "Cell routing",
          "cwd": "cadenza-cell",
          "command": "cargo",
          "args": [
            "test",
            "--locked",
            "--test",
            "orchestrator",
            "authority_refresh_groups_target_replicas_and_separates_signal_slices",
            "--",
            "--exact"
          ]
        },
        {
          "label": "Exact reference business flows",
          "cwd": "cadenza-reference-system",
          "command": "npm",
          "args": ["run", "validate:release", "--", "../cadenza"]
        }
      ]
    },
