    "privileged": {
      "purpose": "Rebuild and prove distributed execution plus replica/provider restart from fresh authority under Linux and gVisor.",
      "transport": "lima",
      "source_repositories": [
        ".",
        "cadenza",
        "cadenza-environment",
        "cadenza-chamber",
        "cadenza-cell",
        "cadenza-reference-system"
      ],
      "scenarios": [
        "two_real_cells_converge_database_authority_without_lifecycle_commands",
        "desired_replica_state_supplies_and_releases_pre_enrolled_cells"
