{
  "contract": "cadenza.proof-harness-manifest",
  "version": "1",
  "tiers": {
    "fast": {
      "purpose": "Detect contract, core-behavior, routing, and reference-flow regressions without privileged infrastructure.",
      "source_repositories": [
        ".",
        "cadenza",
        "cadenza-environment",
        "cadenza-chamber",
        "cadenza-cell",
        "cadenza-reference-system"
      ],
      "commands": [
        {
          "label": "workspace governance",
          "cwd": ".",
          "command": "./scripts/check-agent-harness.sh",
          "args": []
