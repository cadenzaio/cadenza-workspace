            "bash",
            "-lc",
            "cp -a /source /work && cd /work && dotnet restore --locked-mode && dotnet package list --vulnerable --include-transitive && dotnet package list --deprecated --include-transitive && dotnet format --verify-no-changes && dotnet build --configuration Release --no-restore -warnaserror && dotnet test --configuration Release --no-build && bash scripts/package-smoke.sh"
